# Grab data for false belief task
directory_path <- "../../data/processed/fb_logit_lens/"
csv_files <- list.files(path = directory_path, pattern = "*.csv", full.names = TRUE)
csv_list <- csv_files %>%
map(~ read_csv(.))
df_all_models <- bind_rows(csv_list) %>%
mutate(model_shorthand = str_to_title(model_shorthand))
nrow(df_all_models)
df_just_olmo = df_all_models %>%
mutate(correct = case_when(
condition == "False Belief" & log_odds > 0 ~ TRUE,
condition == "True Belief" & log_odds <= 0 ~ TRUE,
TRUE ~ FALSE  # all other cases are incorrect
)) %>%
filter(model_shorthand == "Olmo 2 13b")
df_lo_by_layer = df_just_olmo %>%
group_by(model_shorthand, step, condition, layer, knowledge_cue) %>%
summarise(mean_lo = mean(log_odds),
mean_accuracy = mean(correct))
df_lo_by_layer %>%
ggplot(aes(x = layer,
y = mean_lo,
color = condition,
linetype = knowledge_cue)) +
geom_line(size = 1.5) +
geom_hline(yintercept = 0, linetype = "dotted") +
labs(x = "Layer",
y = "Mean Log Odds (Start vs. End)",
color = "Knowledge State",
linetype = "Knowledge Cue") +
theme_minimal() +
scale_color_manual(values = viridisLite::viridis(2, option = "magma",
begin = 0.8, end = 0.15)) +
facet_wrap(~step)
df_lo_by_layer = df_just_olmo %>%
group_by(model_shorthand, step, layer) %>%
summarise(mean_lo = mean(log_odds),
mean_accuracy = mean(correct))
df_lo_by_layer %>%
ggplot(aes(x = layer,
y = mean_accuracy)) +
geom_line(size = 1.5) +
geom_hline(yintercept = .5, linetype = "dotted") +
labs(x = "Layer",
y = "Mean Accuracy") +
theme_minimal() +
scale_color_manual(values = viridisLite::viridis(2, option = "magma",
begin = 0.8, end = 0.15)) +
facet_wrap(~step)
