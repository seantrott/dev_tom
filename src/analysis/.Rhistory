### How do model properties predict the probability of a correct response?
mod_full = glmer(data = df_all_models,
correct ~ # q_label +
log10(num_params) + log10(num_training_tokens) +
base_instruct +
(1|model_family),
family = binomial())
summary(mod_full)
### Linear regression
summary(lm(data = df_all_models,
mean_accuracy ~ log10(num_params) + log10(num_training_tokens) +
base_instruct))
### Linear regression
summary(lm(data = df_summ,
mean_accuracy ~ log10(num_params) + log10(num_training_tokens) +
base_instruct))
