olmo_and_pythia <- df_all_models_fb %>%
filter(stage == "stage1" | is.na(stage)) %>%
filter(model_shorthand != "Pythia 14m")
olmo_and_pythia <- df_all_models_fb %>%
filter(stage == "stage1" | is.na(stage)) %>%
filter(model_shorthand != "Pythia 14m") %>%
filter(model_shorthand != "Olmo 3 7b-Think")
table(olmo_and_pythia$model_shorthand)
olmo_and_pythia <- olmo_and_pythia %>%
mutate(z_nparams = scale(n_params_approx),
z_tokensseen = scale(tokens_seen_numeric_mod))
mod_full = glmer(data = olmo_and_pythia,
correct ~ condition + knowledge_cue +
log10(tokens_seen_numeric_mod) +
(1 | start) +
(1 | model_shorthand),
family = binomial())
summary(mod_full)
