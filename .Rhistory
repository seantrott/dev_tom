rlang::last_trace()
directory_path <- "data/processed/fb_local_control/"
csv_files <- list.files(path = directory_path, pattern = "*.csv", full.names = TRUE)
csv_files
csv_list <- csv_files %>%
map(~ read_csv(.))
df_all_models <- bind_rows(csv_list) %>%
mutate(model_shorthand = str_to_title(model_shorthand))
nrow(df_all_models)
df_all_models$tokens_seen_numeric <- as.numeric(sub("B", "", df_all_models$tokens_seen)) * 1e9
df_all_models = df_all_models %>%
# filter(stage == "stage1") %>%
mutate(model_id = paste(stage, "step", "-", step)) %>%
mutate(tokens_seen_numeric_mod = tokens_seen_numeric + 1)
df_all_models$step[is.na(df_all_models$step)] <- 143000 #hard-coded the final step
df_all_models <- df_all_models %>%
arrange(model_shorthand, step)  # arrange in ascending order
metadata <- read_csv("../../data/raw/metadata_models.csv")
metadata <- read_csv("data/raw/metadata_models.csv")
# merge the metadata with the fb task df
df_all_models_control_task <- df_all_models %>% left_join(metadata, by = "model_shorthand")
tokens_seen_pythia <- read_csv("../../data/raw/pythia_tokens_seen.csv")
tokens_seen_pythia <- read_csv("data/raw/pythia_tokens_seen.csv")
# merge stepwise tokens data for Pythia models
df_all_models_control_task <- df_all_models_control_task %>%
left_join(tokens_seen_pythia %>% select(model_shorthand, step, tokens_seen_from_df1 = tokens_seen_numeric),
by = c("model_shorthand", "step")) %>%
mutate(tokens_seen_numeric = coalesce(tokens_seen_numeric, tokens_seen_from_df1)) %>%
select(-tokens_seen_from_df1) %>%
mutate(tokens_seen_numeric_mod = tokens_seen_numeric + 1)
df_all_models_control_task = df_all_models_control_task %>%
mutate(model_family = case_when(
model_shorthand %in% c("Pythia 14m", "Pythia 1b",
"Pythia 6.9b", "Pythia 12b") ~ "Pythia",
model_shorthand %in% c("Olmo 2 1b", "Olmo 2 7b", "Olmo 2 13b") ~ "Olmo 2",
))
param_lookup <- tibble(
model_shorthand = c("Pythia 14m", "Pythia 1b", "Pythia 6.9b", "Pythia 12b",
"Olmo 2 1b", "Olmo 2 7b", "Olmo 2 13b"),
n_params = c(14e6, 1e9, 6.9e9, 12e9, 1e9, 7e9, 13e9),
model_family = c("Pythia", "Pythia", "Pythia", "Pythia",
"OLMo 2", "OLMo 2", "OLMo 2")
)
df_all_models_control_task = df_all_models_control_task %>%
mutate(correct = log_odds < 0)
df_summ = df_all_models_control_task %>%
group_by(model_shorthand, step, tokens_seen_numeric, condition, knowledge_cue) %>%
summarise(mean_accuracy = mean(correct),
mean_lo = mean(log_odds),
.groups = "drop")
df_summ %>%
ggplot(aes(x = tokens_seen_numeric,
y = mean_accuracy,
color = condition,
shape = knowledge_cue)) +
geom_line() +
geom_hline(yintercept = .5, linetype = "dotted") +
geom_point(size = 2, alpha = .4) +
scale_x_log10() +
scale_color_manual(values = viridisLite::viridis(2, option = "mako",
begin = 0.8, end = 0.15)) +
labs(title = "Control Task Accuracy",
y = "Accuracy",
x = "Number of Tokens Seen (log scale)") +
theme_minimal() +
facet_wrap(~model_shorthand)
df_summ %>%
ggplot(aes(x = tokens_seen_numeric,
y = mean_lo,
color = condition,
shape = knowledge_cue)) +
geom_line() +
geom_point(size = 2, alpha = .5) +
geom_hline(yintercept = 0, linetype = "dotted") +
scale_x_log10() +
scale_color_manual(values = viridisLite::viridis(2, option = "mako",
begin = 0.8, end = 0.15)) +
labs(title = "Control Task Log Odds (Start v. End)",
y = "Log Odds",
x = "Number of Tokens Seen (log scale)") +
theme_minimal() +
facet_wrap(~model_shorthand)
summary(lmer(data = df_all_models_control_task,
log_odds ~ condition + knowledge_cue +
first_mention + recent_mention +
log10(step + 1) +
# log10(n_params) +
(1|start) +
(1 | model_shorthand)))
df_all_models_control_task %>%
group_by(model_shorthand) %>%
mutate(max_step = max(step)) %>%
filter(step == max_step) %>%
ggplot(aes(x = log_odds,
y = condition,
fill = knowledge_cue)) +
scale_fill_manual(values = viridisLite::viridis(2, option = "mako",
begin = 0.8, end = 0.15)) +
geom_density_ridges(alpha = .4) +
theme_minimal() +
facet_wrap(~model_shorthand)
df_all_models %>%
group_by(model_shorthand) %>%
summarise(max_step = max(step))
df_summ_lo <- df_all_models %>%
group_by(model_shorthand) %>%
mutate(max_step = max(step)) %>%
filter(step == max_step) %>%
left_join(param_lookup, by = "model_shorthand") %>%
group_by(model_shorthand, n_params, model_family, condition, knowledge_cue) %>%
summarise(mean_lo = mean(log_odds),
se_lo = sd(log_odds) / sqrt(n()),
.groups = "drop") %>%
mutate(model_shorthand = fct_reorder(model_shorthand, n_params))
df_all_models %>%
group_by(model_shorthand) %>%
summarise(max_step = max(step))
df_summ_lo <- df_all_models %>%
group_by(model_shorthand) %>%
